# Backend (Render)
DATABASE_URL=postgresql://user:password@host.example.com/database?sslmode=require
SECRET_KEY=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=https://your-app.vercel.app
ENVIRONMENT=production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local inference (required for POST /api/v1/resume/analyze to succeed)
# Place a GGUF file on disk first. Never point this at a URL.
# Leave empty to boot the API; analyze then returns 503 model_unavailable.
# LOCAL_MODEL_PATH=/absolute/path/to/model.gguf
# LOCAL_MODEL_CONTEXT=4096
# LOCAL_MODEL_MAX_TOKENS=4096
# LOCAL_MODEL_TEMPERATURE=0.0
# LOCAL_INFERENCE_TIMEOUT_SECONDS=120

# Local backend overrides
# DATABASE_URL=sqlite+aiosqlite:///./careeros.db
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# ENVIRONMENT=development

# Frontend (Vercel)
BACKEND_URL=https://careeros-api.onrender.com
